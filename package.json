{
  "name": "llm-wiki-desktop",
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "private": true,
  "description": "Local-first desktop knowledge base: import, wiki, graph, and AI-assisted curation (Tauri v2 + React + Rust)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle": "node --test --experimental-test-isolation=none scripts/check-initial-bundle.node-test.mjs && node scripts/check-initial-bundle.mjs",
    "check:release-config": "node --test --experimental-test-isolation=none scripts/check-release-config.node-test.mjs scripts/release-assets.node-test.mjs scripts/verify-product-capabilities.node-test.mjs scripts/capability-release-plan.node-test.mjs scripts/verify-capability-catalog.node-test.mjs scripts/verify-embedded-capability-catalog.node-test.mjs && npm run test:updater-signature && node scripts/check-release-version.mjs && node scripts/verify-product-capabilities.mjs --require-release-ready && node scripts/capability-release-plan.mjs && node scripts/verify-capability-catalog.mjs --catalog capabilities/install-catalog.json --trusted-keys capabilities/trusted-keys.json --mode source",
    "test:release-assets": "node --test --experimental-test-isolation=none scripts/release-assets.node-test.mjs && npm run test:updater-signature",
    "test:updater-signature": "cargo test --manifest-path src-tauri/Cargo.toml --locked --no-default-features --bin verify_update_signature",
    "check:command-execution": "node --test --experimental-test-isolation=none scripts/check-tauri-command-execution.node-test.mjs scripts/prepare-project-facts-packaged-fixtures.node-test.mjs scripts/project-facts-packaged-provenance.node-test.mjs && node scripts/check-tauri-command-execution.mjs",
    "check:project-facts-target": "node scripts/check-project-facts-target.mjs",
    "check:release-config:local": "node scripts/check-release-version.mjs --check-git",
    "test:final-four-redlines": "node --test --experimental-test-isolation=none scripts/check-final-four-redlines.node-test.mjs",
    "check:final-four-redlines": "node scripts/check-final-four-redlines.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:capability-tools": "node --test --experimental-test-isolation=none scripts/capability-health-contract.node-test.mjs scripts/capability-release-plan.node-test.mjs scripts/stage-prepared-capability.node-test.mjs scripts/stage-node-capability.node-test.mjs scripts/stage-sensevoice-capability.node-test.mjs scripts/stage-rapidocr-capability.node-test.mjs capabilities/asr-sensevoice-small/runner/core.node-test.mjs capabilities/asr-whisper/runner/core.node-test.mjs capabilities/browser-runtime/runner/policy.smoke.mjs capabilities/browser-runtime/runner/platform-extract.node-test.mjs capabilities/browser-runtime/runner/snapshot-policy.node-test.mjs capabilities/browser-runtime/runner/linux-deps.node-test.mjs capabilities/browser-runtime-lite/runner/index.node-test.mjs capabilities/media-metadata/runner/core.node-test.mjs && python capabilities/ocr-cjk-accurate/runner/core_test.py && python capabilities/office-legacy/runner/office_legacy_pack_test.py",
    "check:import-source-media": "node scripts/check-import-source-media-flow.mjs",
    "check:import-v2-cutover": "node scripts/check-import-v2-cutover.mjs",
    "lint": "eslint . --max-warnings=0",
    "check:console": "node scripts/check-console-log.mjs",
    "check:rust:gui": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:rust:core": "cargo check --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:quick": "node scripts/run-checks.mjs quick",
    "check": "node scripts/run-checks.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/preset-gfm": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/theme-nord": "^7.21.2",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tauri-apps/api": "~2.9.1",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^1.5.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sigma": "^3.0.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "~2.9.5",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "turndown": "^7.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
