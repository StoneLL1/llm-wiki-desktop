{
  "name": "llm-wiki-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:capability-tools": "node --test --test-isolation=none scripts/stage-node-capability.node-test.mjs scripts/stage-sensevoice-capability.node-test.mjs scripts/stage-rapidocr-capability.node-test.mjs capabilities/asr-sensevoice-small/runner/core.node-test.mjs capabilities/browser-runtime/runner/policy.smoke.mjs capabilities/browser-runtime/runner/platform-extract.node-test.mjs capabilities/browser-runtime/runner/snapshot-policy.node-test.mjs capabilities/browser-runtime/runner/linux-deps.node-test.mjs capabilities/browser-runtime-lite/runner/index.node-test.mjs capabilities/media-metadata/runner/core.node-test.mjs && python capabilities/ocr-cjk-accurate/runner/core_test.py && python capabilities/office-legacy/runner/office_legacy_pack_test.py",
    "check:import-source-media": "node scripts/check-import-source-media-flow.mjs",
    "check:import-v2-cutover": "node scripts/check-import-v2-cutover.mjs",
    "lint": "eslint . --max-warnings=0",
    "check:console": "node scripts/check-console-log.mjs",
    "check:rust:gui": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:rust:core": "cargo check --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:quick": "node scripts/run-checks.mjs quick",
    "check": "node scripts/run-checks.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/preset-gfm": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/theme-nord": "^7.21.2",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tauri-apps/api": "~2.9.1",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^1.5.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sigma": "^3.0.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "~2.9.5",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "turndown": "^7.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
