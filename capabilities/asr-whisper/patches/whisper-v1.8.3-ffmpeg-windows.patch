+#ifdef _WIN32
+static std::wstring wide_path(const std::string &path) {
+    unsigned int code_page = CP_UTF8;
+    int length = MultiByteToWideChar(code_page, MB_ERR_INVALID_CHARS, path.c_str(), -1, NULL, 0);
+    if (length == 0) {
+        code_page = CP_ACP;
+        length = MultiByteToWideChar(code_page, 0, path.c_str(), -1, NULL, 0);
+    }
+    if (length == 0) {
+        return {};
+    }
+    std::wstring result(static_cast<size_t>(length), L'\0');
+    if (MultiByteToWideChar(code_page, code_page == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0,
+                            path.c_str(), -1, &result[0], length) == 0) {
+        return {};
+    }
+    result.pop_back();
+    return result;
+}
+
+static int map_file(const std::string &path, HANDLE *file, HANDLE *mapping, u8 **ptr, size_t *size) {
+    const std::wstring native_path = wide_path(path);
+    if (native_path.empty()) {
+        return -1;
+    }
+    *file = CreateFileW(native_path.c_str(), GENERIC_READ,
+                        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (*file == INVALID_HANDLE_VALUE) {
+        return -1;
+    }
+    LARGE_INTEGER file_size;
+    if (!GetFileSizeEx(*file, &file_size) || file_size.QuadPart <= 0 ||
+        static_cast<unsigned long long>(file_size.QuadPart) > std::numeric_limits<size_t>::max()) {
+        CloseHandle(*file);
+        *file = INVALID_HANDLE_VALUE;
+        return -1;
+    }
+    *mapping = CreateFileMappingW(*file, NULL, PAGE_READONLY, 0, 0, NULL);
+    if (*mapping == NULL) {
+        CloseHandle(*file);
+        *file = INVALID_HANDLE_VALUE;
+        return -1;
+    }
+    *ptr = static_cast<u8 *>(MapViewOfFile(*mapping, FILE_MAP_READ, 0, 0, 0));
+    if (*ptr == NULL) {
+        CloseHandle(*mapping);
+        CloseHandle(*file);
+        *mapping = NULL;
+        *file = INVALID_HANDLE_VALUE;
+        return -1;
+    }
+    *size = static_cast<size_t>(file_size.QuadPart);
+    return 0;
+}
+
+static void unmap_file(HANDLE file, HANDLE mapping, u8 *ptr) {
+    UnmapViewOfFile(ptr);
+    CloseHandle(mapping);
+    CloseHandle(file);
+}
