{
  "schemaVersion": 1,
  "repository": {
    "slug": "StoneLL1/llm-wiki-desktop",
    "visibility": "public",
    "originHttps": "https://github.com/StoneLL1/llm-wiki-desktop.git",
    "defaultBranch": "master",
    "releaseCommitPolicy": "tag-commit-must-be-ancestor-of-default-branch"
  },
  "application": {
    "productName": "LLM Wiki Desktop",
    "identifier": "com.llmwiki.desktop",
    "firstPublicVersion": "0.1.0"
  },
  "tags": {
    "stablePattern": "^app-v([0-9]+\\.[0-9]+\\.[0-9]+)$",
    "prereleasePattern": "^app-v([0-9]+\\.[0-9]+\\.[0-9]+)-rc\\.([1-9][0-9]*)$",
    "firstStable": "app-v0.1.0"
  },
  "endpoints": {
    "stableUpdaterManifest": "https://github.com/StoneLL1/llm-wiki-desktop/releases/latest/download/latest.json",
    "capabilityAssetBaseTemplate": "https://github.com/StoneLL1/llm-wiki-desktop/releases/download/<exact-tag>/"
  },
  "publishing": {
    "latestManifestChannel": "stable-only",
    "stableEnvironment": "desktop-release",
    "capabilityEnvironment": "capability-release",
    "approvalOwner": "StoneLL1",
    "approvalOwnerRole": "sole repository owner and maintainer",
    "approvalOwnerStatus": "confirmed",
    "environmentReviewer": "StoneLL1",
    "environmentReviewerStatus": "configured",
    "environmentPreventSelfReview": false
  },
  "acceptance": {
    "firstStable": {
      "version": "0.1.0",
      "tag": "app-v0.1.0",
      "priorVersionUpgradeGate": "waived-once-no-prior-production-release",
      "replacementGate": "four-platform-clean-install-required",
      "scope": "first-stable-only",
      "approvedBy": "StoneLL1",
      "approvedOn": "2026-08-26"
    },
    "subsequentStable": {
      "firstRequiredVersion": "0.1.1",
      "priorVersionUpgradeGate": "real-prior-production-to-candidate-required"
    }
  },
  "signing": {
    "privateKeyPolicy": "protected-environment-secrets-only",
    "continuity": {
      "backupCustodianRequired": false,
      "decisionOwner": "StoneLL1",
      "riskStatus": "single-maintainer-continuity-risk-accepted"
    },
    "updater": {
      "publicKey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMjc0RUU4OEFCOTA2NTYKUldSV0JybUs2RTRuRGN2UlZENGdNY1FxUE1aZ2F1Y2NBSnpiZ25qTmRtdURURzYrMitUdms4SUEK",
      "publicKeyId": "0D274EE88AB90656",
      "publicKeyStatus": "confirmed-existing-keypair",
      "owner": "StoneLL1",
      "ownerRole": "sole repository owner and maintainer",
      "status": "owner-confirmed",
      "backupCustodian": null,
      "backupStatus": "not-required",
      "rotationProcedure": "docs/release/release-identity-and-access.md#updater-signing-key-operations"
    },
    "capability": {
      "publicKeyId": "llm-wiki-capability-v1",
      "publicKeyStatus": "committed",
      "owner": "StoneLL1",
      "ownerRole": "sole repository owner and maintainer",
      "status": "owner-confirmed",
      "backupCustodian": null,
      "backupStatus": "not-required",
